# Copy to .env.local and fill in values. List variable names only; never commit values.
# Only NEXT_PUBLIC_-prefixed variables reach the browser.

# --- Database (server only: never give these a NEXT_PUBLIC_ prefix) ---
# Validated by src/lib/db/env.ts. Local setup: scripts/db/README.md.
# Database URLs need an explicit user, host, port, and database, and no ?query
# parameters (TLS and session settings are configured in code). Percent-encode
# special characters in passwords.

# Runtime connection, as the application role. May point at a connection pooler.
# Shape: postgresql://<app role>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Direct connection for migrations, as the migration role. Never a transaction pooler.
# Shape: postgresql://<migration role>:<password>@<host>:<port>/<database>
DATABASE_MIGRATION_URL=

# TLS for DATABASE_URL and DATABASE_MIGRATION_URL: verify-full (the default when
# empty; verifies the certificate chain and host name) or disable (accepted only
# for loopback hosts such as 127.0.0.1; use it with local Postgres.app).
DATABASE_SSL_MODE=

# Optional PEM CA bundle, for providers whose server certificates aren't signed by
# a publicly trusted CA. Certificates only; \n sequences become newlines.
DATABASE_SSL_CA=

# Optional pool size per server process: 1 to 100 (default 10).
DATABASE_POOL_MAX=

# Integration tests only: a loopback host and a database ending in _test, separate
# from the databases above. Never point it at a shared or hosted database.
# Shape: postgresql://<test role>:<password>@127.0.0.1:<port>/<database>_test
TEST_DATABASE_URL=
